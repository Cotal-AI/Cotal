{
  "name": "@cotal-ai/workspace",
  "description": "Cotal machine-local workstation layer: the ~/.cotal mesh registry, target resolution, preflight, on-disk auth-path I/O, and the command-copy renderer — operator concerns over a local checkout, kept separate from the wire protocol in @cotal-ai/core.",
  "version": "0.90.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cotal-AI/Cotal.git",
    "directory": "packages/workspace"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.smoke.json",
    "build": "node scripts/build-native.mjs && tsc -p tsconfig.json",
    "build:native": "node scripts/build-native.mjs",
    "test": "tsx smoke/preflight.smoke.ts && tsx smoke/maintenance.smoke.ts && tsx smoke/manager-shutdown.smoke.ts",
    "prepack": "node scripts/assert-shipped-natives.mjs",
    "prepublishOnly": "node scripts/assert-shipped-natives.mjs && pnpm run build"
  },
  "dependencies": {
    "@cotal-ai/core": "workspace:*"
  },
  "devDependencies": {
    "@cotal-ai/smoke-kit": "workspace:*"
  },
  "files": [
    "dist",
    "build/Release",
    "native",
    "scripts"
  ],
  "publishConfig": {
    "access": "public"
  }
}
