{
  "name": "@cotal-ai/lang",
  "description": "cotal-lang: the restricted-JS workflow language. Parser and validator, the effect interface, the step journal, the interpreter, and the simulation handler. Depends on nothing else in the repo.",
  "version": "0.74.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cotal-AI/Cotal.git",
    "directory": "packages/lang"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine/worker-entry": {
      "import": "./dist/engine/worker-entry.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.check.json",
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build:emit && tsx smoke/_run.ts",
    "prepublishOnly": "pnpm run build",
    "build:emit": "tsc -p tsconfig.json --noCheck"
  },
  "dependencies": {
    "acorn": "^8.15.0",
    "json-canonicalize": "2.0.0",
    "ses": "^2.3.0"
  },
  "files": [
    "conformance",
    "dist"
  ],
  "devDependencies": {
    "@cotal-ai/smoke-kit": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
