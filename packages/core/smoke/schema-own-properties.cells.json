      "id": "M09",
      "case": "unevaluatedItems.json:8:unevaluatedItems with nested items",
      "description": "with no additional items",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "unevaluatedItems": {
          "type": "boolean"
