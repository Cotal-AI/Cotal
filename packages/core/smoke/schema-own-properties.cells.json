    {
      "id": "M13",
      "case": "unevaluatedItems.json:23:unevaluatedItems and contains interact to control item dependency relationship",
      "description": "only b's are invalid",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "if": {
          "contains": {
            "const": "a"
          }
        },
        "then": {
          "if": {
            "contains": {
              "const": "b"
            }
          },
          "then": {
            "if": {
              "contains": {
                "const": "c"
              }
            }
          }
        },
        "unevaluatedItems": false
      },
      "value": [
        "b",
        "b"
