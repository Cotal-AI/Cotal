    {
      "id": "M11",
      "case": "unevaluatedItems.json:21:unevaluatedItems depends on adjacent contains",
      "description": "contains passes, second item is not evaluated",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "prefixItems": [
          true
        ],
        "contains": {
          "type": "string"
        },
        "unevaluatedItems": false
      },
      "value": [
        1,
        2,
        "foo"
      ],
      "expected": false,
      "closureDigest": "sha256:859aa1d3db0154910c7547df1eb8fbefa05e4ca51200bfc05c5a6f4d73f0d990"
    },
    {
      "id": "M12",
      "case": "unevaluatedItems.json:22:unevaluatedItems depends on multiple nested contains",
      "description": "7 not evaluated, fails unevaluatedItems",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "allOf": [
          {
            "contains": {
              "multipleOf": 2
            }
          },
