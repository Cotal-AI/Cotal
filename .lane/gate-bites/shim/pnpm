#!/usr/bin/env node
/**
 * A `pnpm` STUB placed first on PATH, so `bin/smoke/shard.mjs` — the real CI entry point — can be
 * driven end to end without running pnpm inside a git worktree (pnpm tries to remove the symlinked
 * node_modules) and without running the other 219 suites.
 *
 * WHAT IS REAL HERE, and it is the whole point: the chain text, the split, the round-robin, the
 * spawn, the exit-code check and the abort are shard.mjs's own, unmodified. Only the LAUNCHER is
 * substituted, and only for members this run is not measuring.
 *
 * WHAT IS NOT REAL: every member outside RUN_FOR_REAL is a no-op that logs its name and exits 0. So
 * this run says nothing whatsoever about those 219 suites. It answers one question — when the
 * delivery-health member exits nonzero, does the chain go red and stop? — and nothing else.
 *
 * It REFUSES rather than guessing: an unknown argument shape, a script that is not defined, or a
 * script body that is not a plain `tsx <file>` invocation all exit nonzero with a named reason. A
 * stub that silently passed on a shape it did not understand would manufacture the green it is
 * supposed to be testing.
 */
import { readFileSync, appendFileSync } from "node:fs";
import { spawnSync } from "node:child_process";

const LOG = process.env.GATE_BITES_LOG;
const REAL = (process.env.GATE_BITES_REAL ?? "").split(",").filter(Boolean);
const REAL_PNPM = process.env.GATE_BITES_PNPM;
if (!LOG || REAL.length === 0 || !REAL_PNPM) {
  console.error("pnpm-shim: REFUSING — GATE_BITES_LOG, GATE_BITES_REAL and GATE_BITES_PNPM must all be set");
  process.exit(97);
}

const args = process.argv.slice(2);
// NOT a chain member: the live suite spawns its fixture daemon with `pnpm exec tsx …` and inherits
// this PATH. The first version of this shim refused that shape, the daemon never started, and the
// baseline ran 4 passed / 13 failed — the shim manufacturing the very red it was meant to observe.
// It refused instead of exiting 0, which is the only reason that was visible at all. Anything that
// is not a bare script name is delegated to the REAL pnpm, unchanged.
if (!(args.length === 1 && /^smoke(:[A-Za-z0-9:_-]+)?$/.test(args[0]))) {
  appendFileSync(LOG, `PASSTHROUGH ${args.join(" ")}\n`);
  const r = spawnSync(REAL_PNPM, args, { stdio: "inherit" });
  process.exit(r.status === null ? 98 : r.status);
}
const name = args[0];

const pkg = JSON.parse(readFileSync(new URL("../../../package.json", import.meta.url), "utf8"));
const body = pkg.scripts?.[name];
if (typeof body !== "string") {
  console.error(`pnpm-shim: REFUSING — no script named ${name} in package.json`);
  process.exit(97);
}

if (!REAL.includes(name)) {
  appendFileSync(LOG, `STUB ${name}\n`);
  process.exit(0);
}

// A member this run IS measuring: run it for real, through tsx directly.
const m = /^tsx\s+(\S+)$/.exec(body.trim());
if (!m) {
  console.error(`pnpm-shim: REFUSING — ${name} is not a plain \`tsx <file>\` script: ${body}`);
  process.exit(97);
}
appendFileSync(LOG, `REAL ${name}\n`);
const r = spawnSync(process.execPath, ["node_modules/tsx/dist/cli.mjs", m[1]], {
  stdio: "inherit",
  cwd: new URL("../../../", import.meta.url).pathname,
});
appendFileSync(LOG, `EXIT ${name} ${r.status}\n`);
process.exit(r.status === null ? 98 : r.status);
