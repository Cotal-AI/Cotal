# The frozen legacy CI gate registry is positional (`index % count`) and must not gain entries.
# Future suites live one-per-file under ci-suites.d, so independent PRs add independent paths and
# GitHub's server-side merge needs no custom driver or manual tail ordering.
bin/smoke/ci-suites.txt !merge

# The conformance corpus is a shipped artifact whose bytes the suite holds identical to a fresh
# build; a CRLF checkout would rewrite it and fail that gate on Windows for nothing.
packages/lang/conformance/corpus.json text eol=lf

# Native build receipts bind compiler input bytes to Git blobs on every platform.
packages/workspace/native/win32-process.c text eol=lf
packages/workspace/native/win32-system-id.cpp text eol=lf
packages/workspace/native/darwin-process.c text eol=lf
packages/workspace/native/node-sdk.json text eol=lf
packages/workspace/scripts/build-native.mjs text eol=lf
packages/workspace/scripts/native-contract.mjs text eol=lf
