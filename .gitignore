node_modules/
.pnpm-store/
dist/
.cotal/
# pi-CLI task transcripts: per-developer working state, never committed
.pi/
*.log
*.out
.DS_Store
remotion/out/
# generated at prepack from the built connectors (bin/scripts/copy-seeded-connectors.mjs)
bin/seeded-connectors/
# local dev config (machine-specific paths); the plugin's is extensions/connector-claude-code/.mcp.json
/.mcp.json
.runs/
scratch/
# Historical copies the egress-guard differential writes next to src so relative imports resolve.
extensions/connector-core/src/.egress-guard-arm-*.ts
examples/02-self-improving-console/harness/.*.log
examples/04-frontier-faces/assets/
product
# Without the bare form, `node_modules/` matches only a directory. A worktree that borrows a
# linked install has a node_modules SYMLINK, which git will happily add, and a repository that
# carries that link fails every CI install with ENOTDIR before any test runs.
node_modules

# Lane work product; it records absolute worktree paths.
fix-report.json
# Per-run scratch TMPDIR for smokes that spawn a daemon needing a stable path.
.repro-tmp/
