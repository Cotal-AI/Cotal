              "maxLength": 64
            },
            "requestId": {
              "type": "string",
              "pattern": "^[a-z0-9]{26,32}$"
            },
            "operationId": {
              "type": "string",
              "pattern": "^[a-z0-9]{26,32}$"
            },
            "operation": {
              "const": "prepare"
            },
            "holderPublicKey": {
              "type": "string",
              "pattern": "^U[A-Z2-7]{55}$"
            }
          },
          "required": [
            "v",
            "account",
            "endpoint",
            "requestId",
            "operationId",
            "operation",
            "holderPublicKey"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "v": {
              "const": 2
            },
            "account": {
              "$ref": "#/definitions/account"
            },
            "endpoint": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$",
              "maxLength": 64
            },
            "requestId": {
              "type": "string",
              "pattern": "^[a-z0-9]{26,32}$"
            },
            "operationId": {
              "type": "string",
              "pattern": "^[a-z0-9]{26,32}$"
            },
            "operation": {
              "const": "challenge"
            },
            "instanceId": {
              "type": "string",
              "pattern": "^[a-z0-9]{26,32}$"
            },
            "expected": {
              "$ref": "#/definitions/authority"
            },
            "content": {
              "$ref": "#/definitions/lifecycleContent"
            }
          },
          "required": [
            "v",
            "account",
            "endpoint",
            "requestId",
            "operationId",
            "operation",
            "instanceId",
            "expected",
            "content"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "v": {
              "const": 2
            },
            "account": {
              "$ref": "#/definitions/account"
            },
            "endpoint": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$",
              "maxLength": 64
            },
            "requestId": {
              "type": "string",
              "pattern": "^[a-z0-9]{26,32}$"
            },
            "operationId": {
              "type": "string",
              "pattern": "^[a-z0-9]{26,32}$"
            },
            "operation": {
              "const": "commit"
            },
            "instanceId": {
              "type": "string",
              "pattern": "^[a-z0-9]{26,32}$"
            },
            "expected": {
              "$ref": "#/definitions/authority"
            },
            "content": {
              "$ref": "#/definitions/lifecycleContent"
            },
            "proof": {
              "$ref": "#/definitions/proof"
            }
          },
          "required": [
            "v",
            "account",
            "endpoint",
            "requestId",
            "operationId",
            "operation",
            "instanceId",
            "expected",
            "content",
            "proof"
          ]
        }
      ]
    },
    "callerRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 2
        },
        "account": {
          "$ref": "#/definitions/account"
        },
        "endpoint": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$",
          "maxLength": 64
        },
        "requestId": {
          "type": "string",
