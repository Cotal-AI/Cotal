        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,32}$"
            },
            "targetMode": {
              "const": "self"
            }
          },
          "required": [
            "command",
            "targetMode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,32}$"
            },
            "targetMode": {
              "enum": [
