{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:cotal:proposal:endpoint-authority:v2.3",
  "description": "Review-only closed shapes, not shipped authority. Authority envelope2, discovery3 retains mandatory effect, native request1 unchanged. Stock verifies checksums/signatures, immutable sources, freshness, cross-field equality, canonical digests and aggregate byte bounds. Class vocabulary is not first-slice issuance support.",
  "definitions": {
    "account": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "space": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "accountPublicKey": {
          "type": "string",
          "pattern": "^A[A-Z2-7]{55}$"
        },
        "assignmentRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "space",
        "accountPublicKey",
        "assignmentRevision"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policyRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "namespaceRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "delegationId": {
          "type": "string",
          "pattern": "^[a-z0-9]{26,32}$"
        },
        "delegationRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "policyRevision",
        "namespaceRevision",
        "delegationId",
        "delegationRevision"
      ]
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "challengeId": {
          "type": "string",
          "pattern": "^[a-z0-9]{26,32}$"
        },
        "publicKey": {
          "type": "string",
          "pattern": "^U[A-Z2-7]{55}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      },
      "required": [
        "challengeId",
        "publicKey",
        "signature"
      ]
    },
    "routes": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "instance"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "class"
            },
            "classRevision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "classRevision"
          ]
        }
      ]
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "instance"
            },
            "instanceId": {
              "type": "string",
              "pattern": "^[a-z0-9]{26,32}$"
            }
          },
          "required": [
            "kind",
            "instanceId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "class"
            },
            "expectedClassRevision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
