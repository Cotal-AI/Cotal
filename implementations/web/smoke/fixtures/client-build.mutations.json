{
  "command": "pnpm smoke:web-client-build",
  "suite": [
    "implementations/web/smoke/client-build.smoke.ts"
  ],
  "progressPattern": "^  ok ",
  "mutations": [
    {
      "name": "the manifest stops reading the module ids of the bundled chunks",
      "file": "implementations/web/client/vite.config.ts",
      "find": "          if (p) found.set(p.name, p.root);",
      "replace": "          void p;",
      "expectRed": "bundle-licenses.json names react",
      "cell": "bundle-licenses.json names react",
      "afterRestore": "pnpm --filter @cotal-ai/web build"
    },
    {
      "name": "the manifest is no longer sorted by package",
      "file": "implementations/web/client/vite.config.ts",
      "find": ".sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0))",
      "replace": ".sort(([a], [b]) => (a < b ? 1 : a > b ? -1 : 0))",
      "expectRed": "bundle-licenses.json is sorted by package",
      "cell": "bundle-licenses.json is sorted by package",
      "afterRestore": "pnpm --filter @cotal-ai/web build"
    },
    {
      "name": "the build writes its files outside /assets/",
      "file": "implementations/web/client/vite.config.ts",
      "find": "assetsDir: \"assets\",",
      "replace": "assetsDir: \"static\",",
      "expectRed": "every asset sits under /assets/",
      "cell": "every asset sits under /assets/",
      "afterRestore": "pnpm --filter @cotal-ai/web build"
    },
    {
      "name": "the art seam loads the characters file through a computed specifier, which the bundler cannot follow, so the build ships no characters chunk and the first avatar fails in the browser",
      "file": "implementations/web/client/src/art/index.ts",
      "find": "await import(\"./characters.js\");",
      "replace": "await import(/* @vite-ignore */ [\"./characters\", \"js\"].join(\".\"));",
      "expectRed": "the built scripts carry the character art the avatars draw",
      "cell": "the built scripts carry the character art the avatars draw",
      "afterRestore": "pnpm --filter @cotal-ai/web build"
    }
  ]
}
