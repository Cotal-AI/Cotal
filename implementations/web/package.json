{
  "name": "@cotal-ai/web",
  "description": "Cotal browser observability dashboard as an owned service preset.",
  "version": "0.100.2",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cotal-AI/Cotal.git",
    "directory": "implementations/web"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.smoke.json && pnpm check:ui",
    "check:ui": "astro check --tsconfig ui/tsconfig.json",
    "build:ui": "astro build",
    "test": "tsx smoke/detach.smoke.ts",
    "build": "tsc -p tsconfig.json && rm -rf dist/web && cp -R src/web dist/web && node scripts/copy-vendor.mjs && pnpm build:ui",
    "prepublishOnly": "pnpm run build",
    "test:browser": "tsx smoke/dashboard-browser.smoke.ts",
    "dev": "astro dev"
  },
  "peerDependencies": {
    "@cotal-ai/core": "*",
    "@cotal-ai/workspace": "*"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "^7.1.1",
    "@cotal-ai/core": "workspace:*",
    "@cotal-ai/smoke-kit": "workspace:*",
    "@cotal-ai/workspace": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "~19.2.7",
    "astro": "^7.4.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dompurify": "^3.4.12",
    "lucide-react": "^1.61.0",
    "marked": "^18.0.6",
    "playwright": "^1.64.1",
    "radix-ui": "^1.8.1",
    "react": "^19.2.7",
    "react-dom": "19.2.7",
    "react-resizable-panels": "^4.14.8",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "@shadcn/react": "^0.3.1"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
