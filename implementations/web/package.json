{
  "name": "@cotal-ai/web",
  "description": "Cotal browser observability dashboard: adds the `web` command to the cotal CLI.",
  "version": "0.81.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cotal-AI/Cotal.git",
    "directory": "implementations/web"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json && tsc -p tsconfig.smoke.json && tsc -p tsconfig.smoke-dom.json",
    "test": "tsx smoke/detach.smoke.ts",
    "build": "tsc -p tsconfig.json && vite build --config client/vite.config.ts",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@cotal-ai/core": "*",
    "@cotal-ai/workspace": "*"
  },
  "devDependencies": {
    "@cotal-ai/core": "workspace:*",
    "@cotal-ai/smoke-kit": "workspace:*",
    "@cotal-ai/workspace": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "dompurify": "^3.4.12",
    "jsdom": "^29.1.1",
    "marked": "^18.0.6",
    "radix-ui": "1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "4.5.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "vite": "^8.3.4"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
