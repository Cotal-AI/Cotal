{
  // Typecheck-only companion to tsconfig.json, because rootDir decides what lands in dist and
  // the smoke files must not.
  // This config exists because the smoke tree was typechecked by nothing: the suites run under
  // tsx, which erases types without checking them.
  "extends": "./tsconfig.json",
  // `jsx` (and `.tsx` import paths) because the shell suites render `client/src/Shell.tsx` on the
  // server. There is no DOM lib in this program, so a client module the suites load cannot reach
  // `window` or `document` and pass.
  "compilerOptions": { "noEmit": true, "rootDir": "../..", "jsx": "react-jsx", "allowImportingTsExtensions": true },
  "include": ["smoke/**/*.ts"],
  // The suites that stub or drive a DOM need DOM types and are typechecked by tsconfig.smoke-dom.json
  // instead: the theme suite, and the suites that mount React in jsdom.
  "exclude": ["smoke/client-theme.smoke.ts", "smoke/components.smoke.ts", "smoke/app-mount.smoke.ts", "smoke/sidebar.smoke.ts", "smoke/views.smoke.ts", "smoke/topology-view.smoke.ts", "smoke/agents-view.smoke.ts", "smoke/mount.ts"]
}
