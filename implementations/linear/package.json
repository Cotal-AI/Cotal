{
  "name": "@cotal-ai/linear",
  "description": "Cotal Linear integration: adds the `linear` command, a bounded client for the official Linear MCP server.",
  "version": "0.58.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cotal-AI/Cotal.git",
    "directory": "implementations/linear"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
