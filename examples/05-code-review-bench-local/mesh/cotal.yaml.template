apiVersion: cotal/v1
kind: Mesh
space: __SPACE__
runtime: pty
agent: opencode
personaPermissions: reject

agents:
  poster:
    persona: ./poster.md
    agent: opencode
    model: openai/gpt-5.4-mini
    role: packet-poster
  bug-hunter:
    persona: ./bug-hunter.md
    agent: opencode
    model: openai/gpt-5.5
    role: reviewer
  breaker:
    persona: ./breaker.md
    agent: opencode
    model: openai/gpt-5.5
    role: reviewer
  keeper:
    persona: ./keeper.md
    agent: opencode
    model: openai/gpt-5.5
    role: reviewer

channels:
  review.gateway:
    description: Shared review room for the benchmark PR packet and findings thread.
    subscribe: [poster, bug-hunter, breaker, keeper]
    allowSubscribe: [poster, bug-hunter, breaker, keeper]
    allowPublish: [poster, bug-hunter, breaker, keeper]
