{
  "name": "@cotal-ai/paseo",
  "description": "Cotal Paseo integration: a Paseo Runtime provider for spawning agents into Paseo workspace terminals.",
  "version": "0.127.2",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cotal-AI/Cotal.git",
    "directory": "extensions/paseo"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "tsx smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.smoke.json",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@getpaseo/client": "^0.14.0"
  },
  "peerDependencies": {
    "@cotal-ai/core": "*"
  },
  "devDependencies": {
    "@cotal-ai/core": "workspace:*",
    "tsx": "^4.22.4"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
