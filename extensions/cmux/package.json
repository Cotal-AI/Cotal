{
  "name": "@cotal-ai/cmux",
  "description": "Cotal cmux integration: a cmux Runtime provider for spawning agents into cmux tabs.",
  "version": "0.183.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cotal-AI/Cotal.git",
    "directory": "extensions/cmux"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "tsx smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.smoke.json",
    "build": "tsc -p tsconfig.json --emitDeclarationOnly && esbuild src/index.ts --bundle --minify-whitespace --platform=node --format=esm --target=node20 --outfile=dist/index.js --banner:js=\"import { createRequire as __cotalCreateRequire } from 'node:module'; const require = __cotalCreateRequire(import.meta.url);\" && pnpm run manifest",
    "manifest": "node ../../scripts/plugin-manifest.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@cotal-ai/core": "*"
  },
  "peerDependenciesMeta": {
    "@cotal-ai/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cotal-ai/core": "workspace:*",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.4"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "cotal": {
    "contract": 1,
    "core": "0.183.1",
    "provides": [
      {
        "kind": "runtime",
        "name": "cmux",
        "aliases": []
      }
    ],
    "commands": [],
    "connectors": [],
    "localProcesses": [],
    "servicePresets": []
  }
}
