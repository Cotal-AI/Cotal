{
  // Typecheck-only companion to tsconfig.json, because rootDir decides what lands in dist and
  // the smoke files must not.
  // This config exists because the smoke tree was typechecked by nothing: the suites run under
  // tsx, which erases types without checking them.
  "extends": "./tsconfig.json",
  "compilerOptions": { "noEmit": true, "rootDir": "../.." },
  "include": ["smoke.ts", "*.smoke.ts"]
}
