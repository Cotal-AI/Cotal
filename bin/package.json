{
  "name": "cotal-ai",
  "version": "0.27.0",
  "description": "Cotal — lateral agent coordination over NATS. Run `npx cotal-ai` for the CLI.",
  "license": "Apache-2.0",
  "keywords": [
    "cotal",
    "agents",
    "ai-agents",
    "multi-agent",
    "agent-communication",
    "agent-coordination",
    "agent-orchestration",
    "swarm",
    "pubsub",
    "protocol",
    "nats",
    "jetstream",
    "mcp",
    "a2a"
  ],
  "homepage": "https://github.com/Cotal-AI/Cotal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cotal-AI/Cotal.git",
    "directory": "bin"
  },
  "type": "module",
  "bin": {
    "cotal": "./dist/cotal.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "seeded-connectors": "node scripts/copy-seeded-connectors.mjs",
    "prepack": "node scripts/copy-seeded-connectors.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@cotal-ai/auth": "workspace:*",
    "@cotal-ai/cli": "workspace:*",
    "@cotal-ai/connector-core": "workspace:*",
    "@cotal-ai/core": "workspace:*",
    "@cotal-ai/delivery": "workspace:*",
    "@cotal-ai/manager": "workspace:*",
    "@cotal-ai/workspace": "workspace:*"
  },
  "devDependencies": {
    "@cotal-ai/connector-claude-code": "workspace:*",
    "@cotal-ai/connector-codex": "workspace:*",
    "@cotal-ai/connector-hermes": "workspace:*",
    "@cotal-ai/connector-jcode": "workspace:*",
    "@cotal-ai/connector-opencode": "workspace:*",
    "@cotal-ai/pi": "workspace:*",
    "@cotal-ai/smoke-kit": "workspace:*",
    "@cotal-ai/web": "workspace:*",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "seeded-connectors",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
